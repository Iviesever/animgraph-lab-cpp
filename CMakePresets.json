{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-local-debug",
      "displayName": "Local MSVC Debug (developer environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-local-release",
      "displayName": "Local MSVC Release (developer environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-clang-debug",
      "displayName": "Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ninja-gcc-debug",
      "displayName": "GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-local-debug",
      "configurePreset": "msvc-local-debug",
      "jobs": 4
    },
    {
      "name": "msvc-local-release",
      "configurePreset": "msvc-local-release",
      "jobs": 4
    },
    {
      "name": "ninja-clang-debug",
      "configurePreset": "ninja-clang-debug",
      "jobs": 4
    },
    {
      "name": "ninja-gcc-debug",
      "configurePreset": "ninja-gcc-debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "msvc-local-debug",
      "configurePreset": "msvc-local-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-local-release",
      "configurePreset": "msvc-local-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-clang-debug",
      "configurePreset": "ninja-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-gcc-debug",
      "configurePreset": "ninja-gcc-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
